rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Vehicle catalogue: anyone can read (the public API also reads it); only admins can change it
    match /models/{model} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin list: a signed-in user may only check their own entry. Add admins with
    // `npm run add-admin` or in the Firebase console, never from the website.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
